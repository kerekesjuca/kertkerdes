@model KertKerdes.Models.Kerdes

@{
    ViewData["Title"] = "Kérdés részletei";
}

<div class="question-card">

    <h2>@Model.Cim</h2>

    <p>@Model.Leiras</p>

    <small>@Model.Datum.ToShortDateString()</small>

</div>


<h4 class="mt-4">

    Válaszok

</h4>


@foreach (var valasz in Model.Valaszok.Where(v => v.Jovahagyva))
{
    <div class="answer-card">

        <div>

            @valasz.Szoveg

        </div>

        <small>

            @valasz.Datum.ToShortDateString()

        </small>

    </div>
}


<form method="post"
      action="/Valasz/Letrehozas"
      class="mt-4">

    <input type="hidden"
           name="KerdesId"
           value="@Model.Id" />

    <textarea name="Szoveg"
              class="form-control"
              rows="4"></textarea>

    <button type="submit"
            class="btn btn-success mt-3">

        Válasz beküldése

    </button>

</form>
@model KertKerdes.Models.Kerdes

@{
    ViewData["Title"] = "Új kérdés";
}

<h2>Új kérdés feltevése</h2>

<form method="post">

    <div class="mb-3">

        <label class="form-label">Cím</label>

        <input name="Cim"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label class="form-label">Leírás</label>

        <textarea name="Leiras"
                  class="form-control"></textarea>

    </div>

    <div class="mb-3">

        <label class="form-label">Témakör</label>

        <input name="Temakor"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-success">

        Beküldés

    </button>

</form>
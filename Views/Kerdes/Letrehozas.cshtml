@model KertKerdes.Models.Kerdes

@{
    ViewData["Title"] = "Új kérdés feltevése";
}

<div class="card question-card">

    <div class="card-body p-4">

        <h2 class="mb-4">

            <i class="bi bi-plus-circle"></i>
            Új kérdés feltevése

        </h2>

        <form method="post">

            <div class="mb-4">

                <label class="form-label">

                    <i class="bi bi-pencil"></i>
                    Kérdés címe

                </label>

                <input asp-for="Cim"
                       class="form-control form-control-lg" />

            </div>


            <div class="mb-4">

                <label class="form-label">

                    <i class="bi bi-card-text"></i>
                    Kérdés leírása

                </label>

                <textarea asp-for="Leiras"
                          class="form-control"
                          rows="5"></textarea>

            </div>


            <div class="mb-4">

                <label class="form-label">

                    <i class="bi bi-tag"></i>
                    Témakör

                </label>

                <select asp-for="TemakorId"
                        class="form-select">

                    @foreach (var temakor in ViewBag.Temakorok)
                    {
                        <option value="@temakor.Id">

                            @temakor.Nev

                        </option>
                    }

                </select>

            </div>


            <div class="mb-4">

                <label class="form-label">

                    <i class="bi bi-tags"></i>
                    Címkék

                </label>

                <select name="kivalasztottCimkek"
                        class="form-select"
                        multiple
                        size="5">

                    @foreach (var cimke in ViewBag.Cimkek)
                    {
                        <option value="@cimke.Id">

                            @cimke.Nev

                        </option>
                    }

                </select>

            </div>


            <button type="submit"
                    class="btn btn-success btn-lg">

                <i class="bi bi-send"></i>
                Beküldés

            </button>

        </form>

    </div>

</div>
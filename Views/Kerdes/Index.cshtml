@model List<KertKerdes.Models.Kerdes>

@{
    ViewData["Title"] = "Kertészeti Közösség";
}

<div class="hero-section">

    <h1>Kertészeti Közösség</h1>

    <p>Kérdezz, válaszolj, és oszd meg tudásod a kertészet szerelmeseivel!</p>

    <form method="get" class="search-box">
        <input name="kereses" placeholder="Keresés kérdésekben..." />
    </form>

</div>

<div class="main-grid">

    <div class="content-left">

        <div class="temakor-sor">

            <span class="temakor-badge active">Összes</span>

            @foreach (var temakor in ViewBag.Temakorok)
            {
                <span class="temakor-badge">
                    @temakor.Nev
                </span>
            }

        </div>

        @foreach (var kerdes in Model)
        {
            <div class="question-card-modern">

                <div class="vote-box">

                    <a href="/Szavazat/KerdesFel/@kerdes.Id">▲</a>

                    <strong>@kerdes.Szavazat</strong>

                    <a href="/Szavazat/KerdesLe/@kerdes.Id">▼</a>

                </div>

                <div class="question-body">

                    <h4>
                        <a href="/Kerdes/Reszletek/@kerdes.Id">
                            @kerdes.Cim
                        </a>
                    </h4>

                    <p>@kerdes.Leiras</p>

                    <div class="question-footer">
                        <span>@kerdes.Datum.ToString("yyyy. MM. dd.")</span>
                    </div>

                </div>

            </div>
        }

        <a href="/Kerdes/Letrehozas" class="btn-modern-green">
            Új kérdés feltevése
        </a>

    </div>

    <div class="content-right">

        <div class="side-card">

            <h5>Népszerű címkék</h5>

            <div class="tag-list">

                <span>#komposzt</span>
                <span>#öntözés</span>
                <span>#palánta</span>
                <span>#bio</span>

            </div>

        </div>

        <div class="side-card green-card">

            <h5>Közösségi statisztika</h5>

            <div class="stat-big">
                <div>@ViewBag.KerdesDb</div>
                <span>Kérdés</span>
            </div>

            <div class="stat-big">
                <div>@ViewBag.ValaszDb</div>
                <span>Válasz</span>
            </div>

        </div>

    </div>

</div>
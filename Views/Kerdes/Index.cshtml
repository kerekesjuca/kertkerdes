@model List<KertKerdes.Models.Kerdes>

@{
    ViewData["Title"] = "Kertészeti Közösség";
}

<div class="hero">

    <h1>Kertészeti Közösség</h1>

    <p>
        Kérdezz, válaszolj, és oszd meg tudásod a kertészet szerelmeseivel!
    </p>

    <div class="d-flex gap-3 mt-4">

        <form method="get" class="flex-grow-1">

            <input name="kereses"
                   class="form-control form-control-lg"
                   placeholder="Keresés kérdésekben..." />

        </form>

        <a href="/Kerdes/Letrehozas"
           class="btn btn-light btn-lg">

            <i class="bi bi-plus"></i>
            Kérdés feltevése

        </a>

    </div>

</div>


<div class="row">

    <div class="col-md-8">

        <h5 class="mb-3">

            <i class="bi bi-funnel"></i>
            Szűrés témakör szerint

        </h5>

        @foreach (var kerdes in Model)
        {
            <div class="card question-card">

                <div class="card-body">

                    <div class="row">

                        <div class="col-2 vote-box">

                            <a href="/Szavazat/KerdesFel/@kerdes.Id"
                               class="btn btn-success btn-sm">

                                <i class="bi bi-arrow-up"></i>

                            </a>

                            <div class="vote-number mt-2 mb-2">

                                @kerdes.Szavazat

                            </div>

                            <a href="/Szavazat/KerdesLe/@kerdes.Id"
                               class="btn btn-danger btn-sm">

                                <i class="bi bi-arrow-down"></i>

                            </a>

                        </div>

                        <div class="col-10">

                            <h5>

                                <a href="/Kerdes/Reszletek/@kerdes.Id"
                                   class="text-decoration-none">

                                    @kerdes.Cim

                                </a>

                            </h5>

                            <p>@kerdes.Leiras</p>

                            <small class="text-muted">

                                <i class="bi bi-tag"></i>
                                @kerdes.Temakor

                            </small>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <div class="col-md-4">

        <div class="stat-box">

            <h5>

                <i class="bi bi-bar-chart"></i>
                Közösségi statisztika

            </h5>

            <p>
                <strong>@ViewBag.KerdesDb</strong> kérdés
            </p>

            <p>
                <strong>@ViewBag.ValaszDb</strong> válasz
            </p>

        </div>

    </div>

</div>
@model KertKerdes.Models.AdminViewModel

@{
    ViewData["Title"] = "Moderátori felület";
}

<div class="admin-header mb-4">

    <h2>Moderátori felület</h2>

    <p class="text-muted">
        Beküldött kérdések és válaszok jóváhagyása
    </p>

</div>


<div class="admin-tabs mb-4">

    <span class="badge bg-success">
        Várakozó kérdések @Model.VarakozoKerdesek.Count
    </span>

    <span class="badge bg-primary ms-2">
        Adott válaszok @Model.VarakozoValaszok.Count
    </span>

</div>


@if (Model.VarakozoKerdesek.Any())
{
    <h4>Kérdések</h4>

    @foreach (var kerdes in Model.VarakozoKerdesek)
    {
        <div class="card admin-card mb-3">

            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <h5>@kerdes.Cim</h5>

                        <p class="text-muted">
                            @kerdes.Leiras
                        </p>

                        <span class="badge bg-light text-dark">
                            @kerdes.TemakorId
                        </span>

                    </div>

                    <div class="col-md-4 text-end">

                        <a href="/Kerdes/Reszletek/@kerdes.Id"
                           class="btn btn-outline-secondary btn-sm">

                            Megtekintés

                        </a>

                        <a href="/Admin/KerdesJovahagy/@kerdes.Id"
                           class="btn btn-success btn-sm">

                            Jóváhagyás

                        </a>

                        <a href="/Admin/KerdesTorles/@kerdes.Id"
                           class="btn btn-danger btn-sm">

                            Törlés

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }
}


@if (Model.VarakozoValaszok.Any())
{
    <h4 class="mt-5">Válaszok</h4>

    @foreach (var valasz in Model.VarakozoValaszok)
    {
        <div class="card admin-card mb-3">

            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <p>@valasz.Szoveg</p>

                    </div>

                    <div class="col-md-4 text-end">

                        <a href="/Admin/ValaszJovahagy/@valasz.Id"
                           class="btn btn-success btn-sm">

                            Jóváhagyás

                        </a>

                        <a href="/Admin/ValaszTorles/@valasz.Id"
                           class="btn btn-danger btn-sm">

                            Törlés

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }
}